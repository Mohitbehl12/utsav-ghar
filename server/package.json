{
  "name": "shubh-aangan-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Utsav Ghar e-commerce API — Express + SQLite",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "test": "node --test \"test/*.test.js\"",
    "e2e:crm": "node test/e2e-crm.mjs",
    "ratings:recompute": "node src/scripts/recompute-ratings.js",
    "backup": "node src/scripts/backup.js",
    "e2e:security": "node test/e2e-security.mjs",
    "audit:deps": "npm audit --omit=dev",
    "e2e:support": "node test/e2e-support.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.1"
  }
}
