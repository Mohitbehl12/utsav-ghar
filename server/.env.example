# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=production
PORT=4000
PUBLIC_URL=https://www.utsavghar.in
CORS_ORIGINS=http://localhost:5173

# 32+ random characters each — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_JWT_SECRET=

DB_PATH=data/utsav-ghar.db
UPLOAD_DIR=uploads

# First admin account (created by `npm run seed` if no admin exists). Change the password after first login.
ADMIN_EMAIL=admin@utsavghar.in
ADMIN_PASSWORD=ChangeMe@2026

# Payment gateway (optional but recommended). Secrets live ONLY here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# One-time codes (sign-up, forgot password) go out by email (SMTP) and WhatsApp below.
# Set at least one of them up before launch. SIGNUP_OTP=off switches the sign-up code off.
SIGNUP_OTP=on

# Order emails (needed for codes and order updates)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Utsav Ghar <orders@utsavghar.in>"

# WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved Marketing template for picks & festival alerts (README → Customer messages)
WHATSAPP_MARKETING_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Marketing tracking (optional). Pixel ID and GA4 Measurement ID are set in Admin → Marketing.
# Server-side Purchase events are sent only when you confirm payment.
META_CAPI_TOKEN=          # Events Manager → your Pixel → Settings → Conversions API → Generate access token
META_TEST_EVENT_CODE=     # optional, e.g. TEST12345 while testing in Events Manager → Test events
GA4_API_SECRET=           # GA4 → Admin → Data streams → Web → Measurement Protocol API secrets

# Mobile app links (after the apps are signed): Apple Team ID and the Play app-signing SHA-256 fingerprint(s)
APPLE_TEAM_ID=
ANDROID_SHA256_CERT=

# ---- Security (optional but recommended) ----
# Only allow the admin panel from these IP addresses (comma-separated). Leave empty to allow anywhere (2FA still protects it).
ADMIN_ALLOWED_IPS=
# Where security researchers can report problems (shown at /.well-known/security.txt)
SECURITY_EMAIL=security@utsavghar.in
# Daily database backups (kept on the server; also copy them elsewhere)
BACKUP_DIR=backups
BACKUP_KEEP=14

# Courier / aggregator status webhook (Shiprocket, Delhivery…): POST /api/webhooks/courier with header X-Courier-Token
COURIER_WEBHOOK_SECRET=

# Live courier rates by PIN (optional). Without these, your rate card in Admin → Pricing by PIN is used.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Encrypts dealer bank account numbers at rest (AES-256-GCM). Set a long random value and keep it safe:
# losing it makes stored account numbers unreadable. If empty, a key derived from ADMIN_JWT_SECRET is used.
DATA_ENCRYPTION_KEY=
